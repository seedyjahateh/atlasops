    "items": [
      {
        "id": "abs-001",
        "split": "development",
        "query": "what percentage of revenue is held in the refund reserve",
        "principal": "prn_alice",
        "shouldAbstain": true,
        "why": "The answer exists, in finance/refund-reserve.md, and prn_alice is engineering. The material is excluded rather than absent, so the correct outcome is an abstention; the finance zone's existence is visible, so saying that something was excluded is permitted."
      },
      {
        "id": "abs-002",
        "split": "development",
        "query": "what is Project Harbour",
        "principal": "prn_reader",
        "shouldAbstain": true,
        "why": "The only material is the hidden restricted/ source. PRD 6.4: the wording must be byte-identical to the answer given when nothing was found, because the name is the secret."
      },
      {
        "id": "abs-003",
        "split": "development",
        "query": "what is the refund window",
        "principal": "prn_reader",
        "shouldAbstain": false,
        "why": "Answerable from the public handbook. Present so that over-abstention is measurable: a system that abstains on everything scores perfectly on the rest of this set."
      },
      {
        "id": "abs-004",
        "split": "development",
        "query": "what is the wifi password in the Leeds depot",
        "principal": "prn_reader",
        "shouldAbstain": true,
        "why": "Nothing in the corpus answers this at any access level. Unanswerable rather than forbidden, which is the distinction this set exists to keep separate from the permission probes."
      },
      {
        "id": "abs-005",
        "split": "development",
        "query": "how many depots does the acquisition target operate",
        "principal": "prn_alice",
        "shouldAbstain": true,
        "why": "Answerable only from the hidden source. The question presumes an acquisition; confirming that one exists would be the disclosure, so the wording must match the nothing-found case."
      },
      {
        "id": "abs-006",
        "split": "development",
        "query": "how long is a request trace retained",
        "principal": "prn_alice",
        "shouldAbstain": false,
        "why": "Answerable from the public retention policy. A second answerable case, for a principal whose own zone does not contain the answer."
      },
      {
        "id": "abs-007",
        "split": "held-out",
        "query": "what is in the monthly finance pack",
        "principal": "prn_reader",
        "shouldAbstain": true,
        "why": "Mentioned only inside finance/refund-reserve.md, which prn_reader cannot read."
      }
    ],
