  "groundedAnswers": {
    "id": "corpus-grounded-answers",
    "version": "1.0.0",
    "kind": "grounded-answers",
    "corpusSnapshot": "sha256:f05a2049d6de1bb249071782efe6e5d32e092a7fb39bf65e66af376b5179b8b9",
    "items": [
      {
        "id": "ga-001",
        "split": "development",
        "query": "what is the refund window",
        "principal": "prn_reader",
        "referenceAnswer": "Thirty days from delivery. A refund requested after that window needs an exception from the owner of the order, recorded against the order.",
        "supportingChunks": [
          "chk_91764580378d24f75d19f494b365fcdeab1b56c4e9cea1b3a2047b4ac063ee0f_1"
        ],
        "humanJudgement": {
          "supported": true,
          "contradicted": false
        }
      },
      {
        "id": "ga-002",
        "split": "development",
        "query": "how long are support conversations kept",
        "principal": "prn_reader",
        "referenceAnswer": "Eighteen months. A customer may ask for one to be removed sooner, and the request is honoured unless the conversation is attached to an open dispute.",
        "supportingChunks": [
          "chk_fa7138e2490257270d2a75f072c30705681bd5ec0f8d25dcf8a8bc8e18f68220_2"
        ],
        "humanJudgement": {
          "supported": true,
          "contradicted": false
        }
      },
      {
        "id": "ga-003",
        "split": "development",
        "query": "checkout is failing, what do I check first",
        "principal": "prn_alice",
        "referenceAnswer": "The gateway status page, before anything else: a vendor-side incident means there is nothing to roll back. If the gateway is healthy, compare the current deploy against the last known good one and roll back first.",
        "supportingChunks": [
          "chk_7270adb3e3fc357b0f9c6d49b5d450d7d4290f84eb53db6402e23c94eb493233_2"
        ],
        "humanJudgement": {
          "supported": true,
          "contradicted": false
        }
      },
      {
        "id": "ga-004",
        "split": "development",
        "query": "when does the ledger cut off at quarter end",
        "principal": "prn_frank",
        "referenceAnswer": "At 17:00 on the last working day of the quarter. Entries after the cutoff land in the following quarter regardless of the invoice date, and there is no way to backdate one.",
        "supportingChunks": [
          "chk_b4732eb7536e3d6e2f06d3176e29a6c21dca6caad49924b399fa6d0889692b0d_1"
        ],
        "humanJudgement": {
          "supported": true,
          "contradicted": false
        }
      },
      {
        "id": "ga-005",
        "split": "development",
        "query": "who handles an escalation with the freight vendor",
        "principal": "prn_reader",
        "referenceAnswer": "The depot supervisor, not the account manager, because the account manager cannot see the collection schedule.",
        "supportingChunks": [
          "chk_57da65d8324d564f2a89ac7d4cde7c5142a33547a06ee69a9f66ee185a242a47_3"
        ]
      },
      {
        "id": "ga-006",
        "split": "development",
        "query": "what is the escalation ladder on call",
        "principal": "prn_alice",
        "referenceAnswer": "Primary, then secondary after ten minutes with no acknowledgement, then the engineering manager.",
        "supportingChunks": [
          "chk_1f5b83636373fc555227dd154759a20868ccc2e1f07c1f5e0b602b3c34b38c9c_3"
        ]
      },
      {
        "id": "ga-007",
        "split": "held-out",
        "query": "how long are order records kept and why",
        "principal": "prn_reader",
        "referenceAnswer": "Seven years from delivery, because they are part of the financial record. A deletion request against an order record is refused for that reason.",
        "supportingChunks": [
          "chk_fa7138e2490257270d2a75f072c30705681bd5ec0f8d25dcf8a8bc8e18f68220_1"
        ]
      }
    ],
    "contentHash": "sha256:c0f18a6eb423a9bf8fe23e3c4c806cf6e1d9357aa2217a5d69c1ceaba16abcc9"
  },
