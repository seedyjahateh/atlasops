{
  "name": "atlasops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "boundaries:check": "tsx tools/boundaries/src/cli.ts check",
    "corpus:inventory": "tsx tools/corpus/cli.ts",
    "corpus:check": "tsx tools/corpus/cli.ts --check",
    "datasets:hash": "tsx tools/datasets/cli.ts",
    "datasets:check": "tsx tools/datasets/cli.ts --check",
    "loadrun": "tsx tools/loadrun/cli.ts",
    "loadrun:check": "tsx tools/loadrun/cli.ts --check",
    "boundaries:table": "tsx tools/boundaries/src/cli.ts table --write",
    "boundaries:evidence": "tsx tools/boundaries/src/cli.ts evidence",
    "evidence": "pnpm boundaries:evidence && pnpm app:eval",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm boundaries:check && pnpm corpus:check && pnpm datasets:check && pnpm loadrun:check",
    "app:api": "tsx apps/api/src/main.ts --corpus examples/corpus --acl examples/corpus.acl.json --groups examples/corpus.groups.json",
    "app:ingest": "tsx apps/ingest-worker/src/main.ts --corpus examples/corpus --acl examples/corpus.acl.json",
    "app:eval": "tsx apps/eval-runner/src/main.ts --corpus examples/corpus --acl examples/corpus.acl.json --groups examples/corpus.groups.json --datasets examples/corpus.datasets.json",
    "app:console": "tsx apps/console/src/main.ts",
    "smoke:openai": "tsx tools/smoke/openai.ts",
    "exhibit:rag-02": "tsx exhibits/rag-02-codebase/src/cli.ts",
    "exhibit:rag-03": "tsx exhibits/rag-03-incident/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
