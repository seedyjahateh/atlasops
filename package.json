{
  "name": "atlasops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "boundaries:check": "tsx tools/boundaries/src/cli.ts check",
    "boundaries:table": "tsx tools/boundaries/src/cli.ts table --write",
    "boundaries:evidence": "tsx tools/boundaries/src/cli.ts evidence",
    "evidence": "pnpm boundaries:evidence && pnpm app:eval",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm boundaries:check",
    "app:api": "tsx apps/api/src/main.ts --corpus examples/corpus",
    "app:ingest": "tsx apps/ingest-worker/src/main.ts --corpus examples/corpus",
    "app:eval": "tsx apps/eval-runner/src/main.ts --corpus examples/corpus --datasets packages/evalkit/fixtures/datasets.v1.json --allow-snapshot-mismatch",
    "app:console": "tsx apps/console/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
